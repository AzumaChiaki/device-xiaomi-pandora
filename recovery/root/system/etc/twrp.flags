# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point       fstype   device                   device2                flags

/metadata           f2fs     /dev/block/by-name/metadata                      flags=display="Metadata";backup=1;wipeingui;wrappedkey
/data               f2fs     /dev/block/bootdevice/by-name/userdata           flags=display="Data";backup=1;wipeingui;wipeduringfactoryreset
/cache              ext4     /dev/block/bootdevice/by-name/rescue             flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset
/persist            ext4     /dev/block/bootdevice/by-name/persist            flags=display="Persist";backup=1

# Dynamic Partitions
/system             ext4     /dev/block/mapper/system                         flags=display="System";logical;slotselect
/system             erofs    /dev/block/mapper/system                         flags=display="System";logical;slotselect
/system_ext         ext4     /dev/block/mapper/system_ext                     flags=display="System Ext";logical;slotselect
/system_ext         erofs    /dev/block/mapper/system_ext                     flags=display="System Ext";logical;slotselect
/product            ext4     /dev/block/mapper/product                        flags=display="Product";logical;slotselect
/product            erofs    /dev/block/mapper/product                        flags=display="Product";logical;slotselect
/vendor             ext4     /dev/block/mapper/vendor                         flags=display="Vendor";logical;slotselect
/vendor             erofs    /dev/block/mapper/vendor                         flags=display="Vendor";logical;slotselect
/odm                ext4     /dev/block/mapper/odm                            flags=display="ODM";logical;slotselect
/odm                erofs    /dev/block/mapper/odm                            flags=display="ODM";logical;slotselect
/system_dlkm        ext4     /dev/block/mapper/system_dlkm                    flags=display="System DLKM";logical;slotselect
/system_dlkm        erofs    /dev/block/mapper/system_dlkm                    flags=display="System DLKM";logical;slotselect
/vendor_dlkm        ext4     /dev/block/mapper/vendor_dlkm                    flags=display="Vendor DLKM";logical;slotselect
/vendor_dlkm        erofs    /dev/block/mapper/vendor_dlkm                    flags=display="Vendor DLKM";logical;slotselect
/mi_ext             ext4     /dev/block/mapper/mi_ext                         flags=display="Mi Ext";logical;slotselect
/mi_ext             erofs    /dev/block/mapper/mi_ext                         flags=display="Mi Ext";logical;slotselect

# Boot-critical partitions
/boot               emmc     /dev/block/by-name/boot                          flags=display="Boot";backup=1;flashimg=1;slotselect
/init_boot          emmc     /dev/block/by-name/init_boot                     flags=display="Init Boot";backup=1;flashimg=1;slotselect
/recovery           emmc     /dev/block/by-name/recovery                      flags=display="Recovery";backup=1;flashimg=1;slotselect
/vendor_boot        emmc     /dev/block/by-name/vendor_boot                   flags=display="Vendor_Boot";backup=1;flashimg=1;slotselect
/dtbo               emmc     /dev/block/by-name/dtbo                          flags=display="Dtbo";backup=1;flashimg=1;slotselect
/vbmeta             emmc     /dev/block/by-name/vbmeta                        flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system      emmc     /dev/block/by-name/vbmeta_system                 flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/misc               emmc     /dev/block/by-name/misc                          flags=display="Misc"
/super              emmc     /dev/block/by-name/super                         flags=display="Super";backup=1;flashimg=1

# Firmware & VM partitions
/modem              vfat     /dev/block/bootdevice/by-name/modem              flags=display="Modem";slotselect;fsflags="ro,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"
/modemfirmware      vfat     /dev/block/bootdevice/by-name/modemfirmware      flags=display="Modem Firmware";slotselect;fsflags="ro,shortname=mixed,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"
/dsp                ext4     /dev/block/bootdevice/by-name/dsp                flags=display="DSP";slotselect
/bluetooth          vfat     /dev/block/bootdevice/by-name/bluetooth          flags=display="Bluetooth";slotselect;fsflags="ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0"
/vm-bootsys         ext4     /dev/block/bootdevice/by-name/vm-bootsys         flags=display="VM-Bootsys";slotselect
/vm-persist         ext4     /dev/block/bootdevice/by-name/vm-persist         flags=display="VM-Persist";backup=1
/qmcs               vfat     /dev/block/bootdevice/by-name/qmcs               flags=display="QMCS";fsflags="noatime,nosuid,nodev,context=u:object_r:vendor_qmcs_file:s0"
/spunvm             vfat     /dev/block/bootdevice/by-name/spunvm             flags=display="Spunvm";fsflags="noatime,nosuid,nodev,context=u:object_r:vendor_spunvm_file:s0"
/soccp              vfat     /dev/block/bootdevice/by-name/soccp              flags=display="Soccp";slotselect;fsflags="ro,shortname=lower,uid=0,gid=1000,dmask=227,fmask=337,context=u:object_r:vendor_soccp_file:s0"

# EFS partitions
/efs1               emmc     /dev/block/bootdevice/by-name/modemst1           flags=display="EFS";backup=1
/efs2               emmc     /dev/block/bootdevice/by-name/modemst2           flags=backup=1;subpartitionof=/efs1
/efsc               emmc     /dev/block/bootdevice/by-name/fsc                flags=backup=1;subpartitionof=/efs1
/efsg               emmc     /dev/block/bootdevice/by-name/fsg                flags=backup=1;subpartitionof=/efs1

# Removable storage: USB OTG (sdg-sdh; sda-sdf=internal on this device)
/usb_otg            exfat    /dev/block/sdg1          /dev/block/sdh1         flags=display="USB-Storage";storage;wipeingui;removable;fsflags="utf8"
